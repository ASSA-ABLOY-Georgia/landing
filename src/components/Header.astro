---
/**
 * Header — two-tier system.
 *
 * Tier 1: cyan utility strip — wordmark (52px) + tel/email links. Static: it
 *         scrolls away with the page (only the navy bar sticks).
 * Tier 2: navy nav bar — 4 links, `aria-current="page"` on the active one,
 *         sticky at the top of the viewport.
 * Mobile (<768px): the two tiers merge into ONE cyan bar (☰ მენიუ · wordmark);
 *         the nav becomes a full-screen navy OVERLAY with ~64px rows and the
 *         cyan utility links pinned to its bottom edge.
 *
 * The mobile-nav toggle script is progressive enhancement: the collapse only
 * applies under the `.js` root class, so with JS disabled the panel is a plain
 * always-visible stacked nav.
 *
 * The navy bar's hide/reveal transform hook (`data-header-hidden`) is styled
 * here but driven from BaseLayout, which needs the footer's sentinel as well as
 * this header. It is set for two reasons: scroll direction, and the
 * **footer-proximity hold** — the bar is held hidden while the footer's pill nav
 * is near the top of the viewport, so the two navs are never on screen together.
 */
import { Image } from "astro:assets";
import logoDeepBlue from "../assets/logo-deep-blue.png";
import Icon from "./Icon.astro";
import { contact, isCurrentPath, navItems, ui } from "../data/site";

const pathname = Astro.url.pathname;
---

<header class="site-header" id="site-header" data-nav-open="false">
  <!-- Tier 1 — cyan utility strip (mobile: the single merged bar). -->
  <div class="header__strip">
    <div class="container-boxed header__strip-inner">
      {
        /* Three CSS bars, not the `menu`/`close` icons: two SVGs can only be
          swapped, bars can morph. Both labels ship and are cross-faded, so the
          button is always as wide as „დახურვა" and opening the menu resizes
          nothing else in the bar. */
      }
      <button
        class="header__toggle"
        id="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
      >
        <span class="header__toggle-icon">
          <span class="header__toggle-bar header__toggle-bar--top"></span>
          <span class="header__toggle-bar header__toggle-bar--mid"></span>
          <span class="header__toggle-bar header__toggle-bar--bottom"></span>
        </span>
        <span class="header__toggle-labels">
          <span class="header__toggle-label header__toggle-label--open">{ui.menuOpen}</span>
          <span class="header__toggle-label header__toggle-label--close">{ui.menuClose}</span>
        </span>
      </button>

      <a class="header__brand" href="/">
        {
          /* Up to 36px tall (231w — the ceiling of the mobile clamp below) under
            768px, 52px (333w) above. `densities` emits viewport-blind 1x/2x
            descriptors, so a DPR-2 phone took the 666w desktop asset for a 231px
            box; `widths` + `sizes` lets the browser weigh viewport AND DPR. The
            231px hint is the mark at the widest phone, so it can only
            over-serve. */
        }
        <Image
          src={logoDeepBlue}
          alt="ASSA ABLOY Georgia"
          widths={[231, 333, 462, 666]}
          sizes="(min-width: 768px) 333px, 231px"
          loading="eager"
        />
      </a>

      <ul class="header__utility" role="list">
        <li>
          <a class="header__utility-link" href={contact.phoneHref}>
            <Icon name="phone" size={16} />{contact.phone}
          </a>
        </li>
        <li>
          <a class="header__utility-link" href={contact.emailHref}>
            <Icon name="mail" size={16} />{contact.email}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Tier 2 — navy nav bar (desktop) / navy panel (mobile). -->
  <div class="header__panel" id="site-nav">
    <nav class="header__nav on-dark" aria-label={ui.primaryNavLabel}>
      <div class="container-boxed header__nav-inner">
        <ul class="header__nav-list" role="list">
          {
            navItems.map((item) => (
              <li>
                <a
                  class="header__nav-link"
                  href={item.href}
                  aria-current={isCurrentPath(pathname, item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>

    <!-- Mobile only: the cyan utility links, below the nav. -->
    <div class="header__panel-utility">
      <div class="container-boxed">
        <ul class="header__utility header__utility--panel" role="list">
          <li>
            <a class="header__utility-link" href={contact.phoneHref}>
              <Icon name="phone" size={16} />{contact.phone}
            </a>
          </li>
          <li>
            <a class="header__utility-link" href={contact.emailHref}>
              <Icon name="mail" size={16} />{contact.email}
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</header>

{
  /* Mobile-nav toggle. The script owns state only — `data-nav-open` drives the
    panel, the glyph morph and the label cross-fade from CSS. The open panel
    covers the page, so it also freezes the document behind it (`html.nav-open`)
    and marks the covered landmarks `inert`. */
}
<script is:inline>
  (function () {
    var header = document.getElementById("site-header");
    var toggle = document.getElementById("nav-toggle");
    if (!header || !toggle) return;
    // Looked up per toggle: this script runs inside <header>, before the parser
    // has reached either landmark.
    function setInert(open) {
      // `main-region` is the <main> landmark itself; `main-content` is the
      // skip link's focusable wrapper inside it (BaseLayout).
      var covered = [
        document.getElementById("main-region"),
        document.getElementById("site-footer"),
      ];
      for (var i = 0; i < covered.length; i++) {
        if (covered[i]) covered[i].inert = open;
      }
    }
    function setOpen(open) {
      header.setAttribute("data-nav-open", open ? "true" : "false");
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      document.documentElement.classList.toggle("nav-open", open);
      setInert(open);
    }
    toggle.addEventListener("click", function () {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });
    document.addEventListener("keydown", function (event) {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia("(min-width: 768px)").addEventListener("change", function (event) {
      if (event.matches) setOpen(false);
    });
  })();
</script>

<style>
  .site-header {
    z-index: 40;
    /* One source for the cyan strip's height: it drives both the strip itself and
       the sticky offset, so the two can never drift apart. */
    --header-strip-height: 64px;
    --header-sticky-offset: 0px;
  }

  /* The nav panel lives INSIDE <header>, so the header may only be sticky where
     that panel can be collapsed — i.e. when JS is available. Without JS the panel
     is permanently open, and a sticky header would pin ~440px of nav to the top of
     every mobile viewport. Desktop is always safe (the panel is the 72px navy bar)
     and gets its own sticky rule below.
     The desktop offset pulls the cyan strip out of the sticky area so it scrolls
     away and only the navy bar sticks. */
  :global(html.js) .site-header {
    position: sticky;
    top: calc(-1 * var(--header-sticky-offset));
    transition: transform 0.3s; /* the hide/reveal slide */
  }
  :global(html.js) .site-header[data-header-hidden="true"] {
    transform: translateY(-100%);
  }
  /* A transformed ancestor would become the containing block of the fixed panel
     below, so the bar must not be mid-slide when the menu opens. The reveal
     script already pins it visible; this cancels a slide still in flight. */
  :global(html.js) .site-header[data-nav-open="true"] {
    transform: none;
    transition: none;
  }

  /* ── Tier 1 — cyan utility strip ─────────────────────────────────────────── */
  .header__strip {
    background-color: var(--color-cyan);
  }
  .header__strip-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: var(--header-strip-height);
  }

  .header__brand {
    display: inline-flex;
    align-items: center;
    /* The mark is never what gives way — as a shrinkable item it was squeezed by
       the toggle's wider open-state label on any phone under ~408px. */
    flex-shrink: 0;
  }
  .header__brand :global(img) {
    /* Fluid to its full 36px at ~468px: a fixed 36px (231w) leaves a phone too
       little room for the toggle beside it. Size follows the SCREEN, never the
       menu's state. `max-width: none` drops preflight's `max-width: 100%`, which
       against a fixed height squashes the mark instead of scaling it. */
    height: clamp(28px, 7.7vw, 36px);
    width: auto;
    max-width: none;
  }

  .header__utility {
    display: none;
    align-items: center;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .header__utility-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-deep-blue);
    text-decoration: none;
  }
  .header__utility-link:hover {
    text-decoration: underline;
  }

  /* Mobile toggle — hidden without JS so the nav never becomes unreachable. */
  .header__toggle {
    display: none;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 8px 12px 8px 0;
    font-family: inherit;
    font-size: 15px;
    font-weight: 500;
    color: var(--color-deep-blue);
    background: none;
    border: 0;
    cursor: pointer;
  }

  /* ☰ → ✕ morph, on the 24px frame and bar weight of the `menu` glyph. Two
     stages: the outer bars converge, THEN rotate into the cross (closing
     replays it backwards). Separate stages need separate timelines, hence the
     individual `translate`/`rotate` — one `transform` carries one delay. */
  .header__toggle-icon {
    position: relative;
    display: block;
    flex: none;
    width: 24px;
    height: 24px;
  }
  .header__toggle-bar {
    position: absolute;
    left: 3px;
    top: calc(50% - 1px);
    width: 18px;
    height: 2px;
    background-color: currentColor;
    transition:
      translate 0.16s ease 0.16s,
      rotate 0.16s ease,
      opacity 0.16s ease 0.12s;
  }
  .header__toggle-bar--top {
    translate: 0 -5px;
  }
  .header__toggle-bar--bottom {
    translate: 0 5px;
  }
  .site-header[data-nav-open="true"] .header__toggle-bar {
    translate: 0 0;
    transition:
      translate 0.16s ease,
      rotate 0.16s ease 0.16s,
      opacity 0.12s ease;
  }
  .site-header[data-nav-open="true"] .header__toggle-bar--top {
    rotate: 45deg;
  }
  .site-header[data-nav-open="true"] .header__toggle-bar--bottom {
    rotate: -45deg;
  }
  /* The middle bar has nowhere to go — it fades while the others converge. */
  .site-header[data-nav-open="true"] .header__toggle-bar--mid {
    opacity: 0;
  }

  /* Both labels share one grid cell, so the bar's geometry never changes. */
  .header__toggle-labels {
    display: grid;
    align-items: center;
  }
  .header__toggle-label {
    grid-area: 1 / 1;
    transition:
      opacity 0.18s ease,
      visibility 0s;
  }
  .header__toggle-label--close,
  .site-header[data-nav-open="true"] .header__toggle-label--open {
    opacity: 0;
    /* Hidden, not just transparent — an invisible label must not join the
       button's accessible name. It waits out the fade. */
    visibility: hidden;
    transition-delay: 0s, 0.18s;
  }
  .site-header[data-nav-open="true"] .header__toggle-label--close {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s, 0s;
  }

  /* ── Tier 2 — navy nav ───────────────────────────────────────────────────── */
  .header__nav {
    background-color: var(--color-deep-blue);
  }
  .header__nav-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .header__nav-link {
    display: flex;
    align-items: center;
    min-height: 64px;
    /* Negative margin + matching padding lets the active highlight bleed past the
       label without shifting it (mobile rows). */
    margin-inline: -12px;
    padding: 8px 12px;
    font-size: 16px;
    font-weight: 500;
    color: var(--color-tint-pale);
    text-decoration: none;
    border-top: 1px solid var(--color-deep-blue-active);
    transition: color 0.2s;
  }
  /* No hairline where the first row meets the cyan strip. */
  .header__nav-list li:first-child .header__nav-link {
    border-top: 0;
  }
  .header__nav-link:hover {
    color: var(--color-cyan);
  }
  /* Active page — subtle lighter-navy rounded highlight. */
  .header__nav-link[aria-current="page"] {
    background-color: var(--color-deep-blue-active);
    border-radius: var(--radius-element);
  }

  /* Mobile: cyan utility block below the nav panel. */
  .header__panel-utility {
    background-color: var(--color-cyan);
    padding-block: 16px;
  }
  .header__utility--panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }
  .header__utility--panel .header__utility-link {
    min-height: 44px;
    font-size: 15px;
  }

  /* Collapse the panel only when JS is available (progressive enhancement):
     without JS the toggle stays hidden and the panel is a plain stacked nav.
     `not all and (min-width: 768px)` is the exact complement of the desktop query —
     a `max-width: 767.98px` pair leaves fractional widths matching neither. */
  @media not all and (min-width: 768px) {
    :global(html.js) .header__toggle {
      display: inline-flex;
    }

    /* An OVERLAY, not a block in the header's flow: in flow it pushed the bar
       and the whole document down as it opened, and stopped short of the bottom
       of the screen. Out of flow the header also stays exactly as tall as the
       strip — the number BaseLayout measures for the hide/reveal.

       `bottom: 0`, not a `100dvh` calc: a fixed box already tracks the layout
       viewport, so it follows a mobile URL bar with no re-measuring.

       Closed it is faded out and lifted 8px, with `visibility` deferred to the
       end of the fade to take the rows out of the tab order. */
    :global(html.js) .header__panel {
      position: fixed;
      top: var(--header-strip-height);
      right: 0;
      bottom: 0;
      left: 0;
      display: flex;
      flex-direction: column;
      /* Navy under everything the nav rows and the utility block do not cover,
         so the overlay is opaque edge to edge at any screen height. */
      background-color: var(--color-deep-blue);
      overflow-y: auto;
      overscroll-behavior: contain; /* no scroll chaining to the page behind */
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition:
        opacity 0.2s ease,
        transform 0.2s ease,
        visibility 0s linear 0.2s;
    }
    :global(html.js) .site-header[data-nav-open="true"] .header__panel {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition:
        opacity 0.22s ease,
        transform 0.26s cubic-bezier(0.22, 0.61, 0.36, 1),
        visibility 0s;
    }
    /* Utility links ride the bottom edge, as the live site's ticker does. `auto`
       collapses to 0 when the rows overflow, so a landscape phone just scrolls. */
    :global(html.js) .header__panel-utility {
      margin-top: auto;
    }

    /* Freeze the page behind the overlay — on BODY, never on the root. A root
       with `overflow: hidden` stops being the scrollport its descendants stick
       to, and the bar would drop off-screen the moment the menu was opened below
       the fold (measured: `top` −59px → −900px at scroll 900). Body's overflow
       propagates to the viewport just the same, and sticky survives. */
    :global(html.js.nav-open) body {
      overflow: hidden;
    }
  }

  /* Under the 360px design floor the wordmark and a labelled toggle cannot both
     fit. The label gives way — clipped, not `display: none`, so it is still the
     button's accessible name — and the target stays 44px. */
  @media not all and (min-width: 360px) {
    .header__toggle {
      position: relative;
      min-width: 44px;
      padding-right: 0;
    }
    .header__toggle-labels {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* ── Desktop ─────────────────────────────────────────────────────────────── */
  @media (min-width: 768px) {
    .site-header {
      --header-strip-height: 72px;
      --header-sticky-offset: var(--header-strip-height);
      /* Sticky regardless of JS here: the panel is just the navy bar. */
      position: sticky;
      top: calc(-1 * var(--header-sticky-offset));
    }
    .header__brand :global(img) {
      height: 52px;
    }
    .header__utility {
      display: flex;
    }
    .header__panel-utility {
      display: none;
    }
    .header__nav-inner {
      display: flex;
      align-items: center;
      min-height: 72px;
    }
    .header__nav-list {
      flex-direction: row;
      gap: 4px;
    }
    .header__nav-link {
      min-height: 44px;
      margin-inline: 0;
      padding: 8px 12px;
      font-size: 15px;
      border-top: 0;
      border-radius: var(--radius-element);
    }
  }

  /* Reduced motion kills the hide/reveal outright, not just its transition —
     BaseLayout's script short-circuits to "visible" under the same query,
     footer-proximity hold included. */
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .site-header,
    .header__nav-link {
      transition: none;
    }
    :global(html.js) .site-header[data-header-hidden="true"] {
      transform: none;
    }
    /* The panel, the morph and the cross-fade still HAPPEN — they just arrive
       instead of animating. The valueless `[data-nav-open]` matches either state
       at the specificity of the `="true"` rules above, so one declaration covers
       both directions; `transform: none` drops the closed state's 8px lift. */
    :global(html.js) .site-header[data-nav-open] .header__panel,
    .site-header[data-nav-open] .header__toggle-bar,
    .site-header[data-nav-open] .header__toggle-label {
      transition: none;
    }
    :global(html.js) .header__panel {
      transform: none;
    }
  }

  /* A printout must never inherit a hidden header. `position: sticky` prints as
     static, so a translate left over from the moment the user hit Print would
     carry the wordmark and the nav off the top of page 1. */
  @media print {
    :global(html.js) .site-header[data-header-hidden="true"] {
      transform: none;
    }
  }
</style>

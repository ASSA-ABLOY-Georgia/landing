---
/**
 * Footer — a full-height destination, not a strip. Navy full-bleed, content
 * boxed to 1248px, in seven layers:
 *
 *   1. nav as white pill buttons        5. legal bar
 *   2. large vertical gap               6. giant cyan wordmark band
 *   3. utility row (wordmark + contacts) 7. tagline
 *   4. hairline divider
 *
 * Layer 3's right-hand social icons are omitted: the client has supplied no
 * social profiles.
 *
 * Layer 1 also carries the **sentinel** for the header's footer-proximity hold:
 * a 1px marker pinned to the top edge of the pill row, watched by BaseLayout's
 * header script. The two navs are the same four links and must never meet, so
 * the navy bar is held hidden while the row is near the top of the viewport. The
 * sentinel is what makes that an IntersectionObserver trigger instead of
 * `scrollY` arithmetic — this footer is ~90vh and its height varies.
 */
import Wordmark from "../assets/logo-wordmark.svg";
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import { contact, footer, navItems, ui } from "../data/site";
---

<footer class="site-footer on-dark" id="site-footer">
  <div class="container-boxed site-footer__inner">
    <!-- 1 — nav as white pill buttons -->
    <nav class="site-footer__nav-region" aria-label={ui.footerNavLabel}>
      {
        /* Header footer-proximity-hold sentinel. Absolutely positioned, so it
          marks the top edge of the pill row without joining the layout. */
      }
      <div class="site-footer__sentinel" id="footer-nav-sentinel" aria-hidden="true"></div>
      <ul class="site-footer__nav" role="list">
        {
          navItems.map((item) => (
            <li class="site-footer__nav-item">
              <Button variant="white" href={item.href} arrow={false}>
                {item.label}
              </Button>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- 2 — large vertical gap (see .site-footer__utility margin) -->

    <!-- 3 — utility row -->
    <div class="site-footer__utility">
      {
        /* The label is the wordmark's literal content ("ASSA ABLOY"), not the site
          name — the org's full name is carried by the legal bar below. */
      }
      <div class="site-footer__mark">
        <Wordmark role="img" aria-label="ASSA ABLOY" focusable="false" />
      </div>
      <ul class="site-footer__contact" role="list" aria-label={ui.contactLabel}>
        <li>
          <a class="site-footer__contact-link" href={contact.phoneHref}>
            <Icon name="phone" size={16} />{contact.phone}
          </a>
        </li>
        <li>
          <a class="site-footer__contact-link" href={contact.emailHref}>
            <Icon name="mail" size={16} />{contact.email}
          </a>
        </li>
      </ul>
    </div>

    <!-- 4 — hairline divider -->
    <hr class="site-footer__divider" />

    <!-- 5 — legal bar -->
    <p class="site-footer__legal">{footer.legal}</p>

    <!-- 6 — giant cyan wordmark: the single most cyan moment on the site -->
    <div class="site-footer__wordmark">
      {
        /* Purely graphic — the same two words are already announced by the mark
          in layer 3, so this one is hidden from the a11y tree. */
      }
      <Wordmark aria-hidden="true" focusable="false" />
    </div>

    <!-- 7 — tagline -->
    <p class="site-footer__tagline">{footer.tagline}</p>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-deep-blue);
  }
  .site-footer__inner {
    display: flex;
    flex-direction: column;
    padding-block: 64px;
    min-height: 100vh;
    min-height: 100dvh;
  }

  /* 1 — white pills; stack full-width on mobile. */
  .site-footer__nav-region {
    /* Only to anchor the sentinel. No z-index, so no stacking context. */
    position: relative;
  }
  /* 1px rather than zero-height: a zero-area target is not reliably reported as
     intersecting, and the header's hold depends on that crossing firing. */
  .site-footer__sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }
  .site-footer__nav {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__nav-item {
    display: flex;
  }
  .site-footer__nav-item :global(.btn) {
    width: 100%;
  }

  /* 3 — utility row. Social icons intentionally absent. */
  .site-footer__utility {
    margin-top: 64px;
    /* Absorbs the slack on tall viewports so the footer reads as a destination. */
    margin-bottom: auto;
    padding-bottom: 64px;
  }
  .site-footer__mark :global(svg) {
    display: block;
    width: 178px;
    height: auto;
    /* Paints the wordmark: the SVG is `fill="currentColor"`, so this instance and
       the cyan band below are the same asset at two colours. */
    color: #ffffff;
  }
  .site-footer__contact {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__contact-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: 15px;
    color: var(--color-tint-pale);
    text-decoration: none;
  }
  .site-footer__contact-link:hover {
    color: var(--color-cyan);
  }

  /* 4 — hairline, boxed width */
  .site-footer__divider {
    width: 100%;
    margin: 0;
    border: 0;
    border-top: 1px solid var(--color-tint-pale);
  }

  /* 5 — legal */
  .site-footer__legal {
    margin: 24px 0 0;
    font-size: 16px;
    color: var(--color-cyan-pressed);
  }

  /* 6 — giant cyan wordmark band */
  .site-footer__wordmark {
    margin-top: 48px;
  }
  .site-footer__wordmark :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    color: var(--color-cyan);
  }

  /* 7 — tagline */
  .site-footer__tagline {
    max-width: 70ch;
    margin: 24px 0 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-tint-pale);
  }

  @media (min-width: 768px) {
    .site-footer__inner {
      padding-block: 80px;
    }
    .site-footer__nav {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 16px;
    }
    .site-footer__nav-item {
      min-width: 187px;
    }
    .site-footer__utility {
      margin-top: 96px;
      padding-bottom: 96px;
    }
    .site-footer__contact {
      flex-direction: row;
      gap: 32px;
    }
  }
</style>

---
/**
 * SectionHeading — PLAN §4 / §4.5.
 *
 * Eyebrow (a styled <p>, never a heading) + section heading at --text-h2 / 400,
 * plus the optional decorative "cyan progress rule": a 2px #C0C8DA track with a
 * partial #09C3F1 fill that echoes the live site's carousel progress bar
 * (UX-REPORT §3.6 option A). The rule is purely decorative → aria-hidden.
 *
 * `onDark` recolors for the navy stat band (heading #F2FAFC, eyebrow #B9E1EF).
 */
interface Props {
  title: string;
  eyebrow?: string;
  /** Heading level — h2 by default; h3 keeps the h2→h3 order intact (PLAN §4.5). */
  as?: "h2" | "h3";
  id?: string;
  /** Renders the decorative cyan progress rule beneath the heading. */
  rule?: boolean;
  /** Cyan fill of the rule, in percent. */
  ruleProgress?: number;
  onDark?: boolean;
  class?: string;
}

const {
  title,
  eyebrow,
  as: Heading = "h2",
  id,
  rule = false,
  ruleProgress = 40,
  onDark = false,
  class: className,
} = Astro.props;

// Clamped so a stray value can never overflow the track.
const rulePercent = Math.min(100, Math.max(0, ruleProgress));
---

<div class:list={["section-heading", onDark && "section-heading--on-dark", className]}>
  {eyebrow && <p class="section-heading__eyebrow">{eyebrow}</p>}
  <Heading id={id} class="section-heading__title">{title}</Heading>
  <slot />
  {
    rule && (
      <div class="section-heading__rule" aria-hidden="true">
        <span class="section-heading__rule-fill" style={`width:${rulePercent}%`} />
      </div>
    )
  }
</div>

<style>
  .section-heading__eyebrow {
    margin: 0 0 12px;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-secondary);
  }

  .section-heading__title {
    margin: 0;
    font-size: var(--text-h2);
    font-weight: 400;
    line-height: 1.15;
    color: var(--color-deep-blue);
  }

  /* Decorative progress-rule motif (PLAN §4). */
  .section-heading__rule {
    margin-top: 24px;
    height: 2px;
    width: 100%;
    background-color: var(--color-border);
  }
  .section-heading__rule-fill {
    display: block;
    height: 100%;
    background-color: var(--color-cyan);
  }

  /* Navy surfaces — the sanctioned stat band and the footer. */
  .section-heading--on-dark .section-heading__title {
    color: var(--color-tint-pale);
  }
  .section-heading--on-dark .section-heading__eyebrow {
    color: var(--color-cyan-pressed);
  }
  .section-heading--on-dark .section-heading__rule {
    background-color: var(--color-deep-blue-active);
  }
</style>

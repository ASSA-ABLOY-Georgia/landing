---
/**
 * SectionHeading — PLAN §4 / §4.5.
 *
 * Eyebrow (a styled <p>, never a heading) + section heading at --text-h2 / 400.
 * Nothing is drawn beneath the heading: the decorative cyan progress rule was
 * removed by design revision (DECISIONS DR.1) — headings sit on white space.
 *
 * `onDark` recolors for the navy stat band (heading #F2FAFC, eyebrow #B9E1EF).
 */
interface Props {
  title: string;
  eyebrow?: string;
  /**
   * Heading level — h2 by default; h3 keeps the h2→h3 order intact (PLAN §4.5).
   *
   * Deliberately NOT named `as`: Astro's language server treats an `as` prop as the
   * polymorphic-component signal and silently widens the whole component's props to
   * `any`, so `astro check` stops validating every call site (DECISIONS D6.1).
   */
  level?: "h2" | "h3";
  id?: string;
  onDark?: boolean;
  class?: string;
}

const { title, eyebrow, level: Heading = "h2", id, onDark = false, class: className } = Astro.props;
---

<div class:list={["section-heading", onDark && "section-heading--on-dark", className]}>
  {eyebrow && <p class="section-heading__eyebrow">{eyebrow}</p>}
  <Heading id={id} class="section-heading__title">{title}</Heading>
  <slot />
</div>

<style>
  .section-heading__eyebrow {
    margin: 0 0 12px;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-secondary);
  }

  .section-heading__title {
    margin: 0;
    font-size: var(--text-h2);
    font-weight: 400;
    line-height: 1.15;
    color: var(--color-deep-blue);
  }

  /* Navy surfaces — the sanctioned stat band and the footer. */
  .section-heading--on-dark .section-heading__title {
    color: var(--color-tint-pale);
  }
  .section-heading--on-dark .section-heading__eyebrow {
    color: var(--color-cyan-pressed);
  }
</style>

---
/**
 * /contact/thanks — the Web3Forms `redirect` target.
 *
 * Because success is a real navigation, assistive tech announces it like any
 * other page load — no live region, no JavaScript. `noindex`: a thank-you page
 * must never appear in search results.
 */
import Button from "../../components/Button.astro";
import PageHero from "../../components/PageHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

/* One constant for the body so the paragraph and the meta description cannot
   drift apart. */
const body = "ჩვენ მალე დაგიკავშირდებით.";
---

<BaseLayout title="შეტყობინება გაგზავნილია — ASSA ABLOY Georgia" description={body} noindex>
  <PageHero title="შეტყობინება გაგზავნილია — მადლობა!" single>
    <p>{body}</p>
    <Button variant="white" href="/">მთავარ გვერდზე დაბრუნება</Button>
  </PageHero>
</BaseLayout>

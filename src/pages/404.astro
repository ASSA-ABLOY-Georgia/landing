---
/**
 * 404 — white, H1 + primary CTA back to Home.
 *
 * The <title> follows the „<page> — ASSA ABLOY Georgia" pattern; `noindex`
 * because an error page has nothing to rank.
 */
import Button from "../components/Button.astro";
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

/* One constant for the body so the paragraph and the meta description cannot
   drift apart. */
const body = "სამწუხაროდ, მოთხოვნილი გვერდი არ არსებობს ან გადატანილია.";
---

<BaseLayout title="გვერდი ვერ მოიძებნა — ASSA ABLOY Georgia" description={body} noindex>
  <PageHero title="გვერდი ვერ მოიძებნა" single>
    <p>{body}</p>
    <Button href="/">მთავარ გვერდზე დაბრუნება</Button>
  </PageHero>
</BaseLayout>
